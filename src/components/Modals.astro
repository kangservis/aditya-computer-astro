---
// File: src/components/Modals.astro
---

<!-- TOAST NOTIFICATION -->
<div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 md:left-auto md:right-4 md:translate-x-0 z-[60] flex flex-col gap-2 max-w-[90vw] sm:max-w-sm w-full pointer-events-none px-4 md:px-0"></div>

<!-- CART SIDE DRAWER -->
<div id="cart-drawer" class="hidden fixed inset-0 z-50">
  <div onclick="window.toggleCart(false)" class="absolute inset-0 bg-black/50 backdrop-blur-xs cursor-pointer"></div>
  <div class="absolute inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl flex flex-col h-full">
    <div class="p-4 md:p-6 border-b border-slate-100 flex items-center justify-between">
      <span class="font-display font-bold text-base md:text-lg">Keranjang Belanja</span>
      <button onclick="window.toggleCart(false)" class="text-slate-400 hover:text-slate-900 text-xl cursor-pointer">
        <i class="ri-close-line"></i>
      </button>
    </div>
    <div id="cart-items" class="flex-1 overflow-y-auto p-4 md:p-6 space-y-4"></div>
    <div id="cart-footer" class="p-4 md:p-6 border-t border-slate-100 bg-slate-50 space-y-4 hidden">
      <div class="flex justify-between font-bold text-slate-900 text-sm md:text-base">
        <span>Total Belanja:</span>
        <span id="cart-total" class="text-red-600 text-base md:text-lg">Rp 0</span>
      </div>
      <button onclick="window.openCheckout()" class="w-full py-2.5 md:py-3 bg-red-600 hover:bg-red-700 text-white font-semibold text-xs rounded-xl transition-all cursor-pointer">
        Lanjut ke Form Checkout
      </button>
    </div>
  </div>
</div>

<!-- CHECKOUT MODAL -->
<div id="checkout-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div onclick="window.toggleCheckoutModal(false)" class="absolute inset-0 bg-black/50 cursor-pointer"></div>
  <div class="bg-white rounded-2xl p-5 md:p-6 max-w-md w-full relative z-10 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
    <h3 class="font-display font-bold text-base md:text-lg">Form Alamat Pengiriman</h3>
    <div class="space-y-3">
      <input type="text" id="order-name" placeholder="Nama Lengkap Penerima" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs outline-none" />
      <input type="text" id="order-phone" placeholder="No. WhatsApp Aktif" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs outline-none" />
      <textarea id="order-address" rows="3" placeholder="Alamat Pengiriman Lengkap" class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs leading-relaxed outline-none"></textarea>
      <div class="bg-slate-50 p-3 md:p-4 rounded-xl text-xs space-y-1 border border-slate-100">
        <p class="font-bold text-slate-700">Ringkasan Total Pembayaran:</p>
        <p id="checkout-total-txt" class="font-black text-red-600 text-sm md:text-base">Rp 0</p>
      </div>
      <button onclick="window.submitOrder()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl transition-all cursor-pointer">
        Pesan & Konfirmasi WhatsApp
      </button>
    </div>
  </div>
</div>

<!-- MODAL DETAIL PRODUK -->
<div id="product-detail-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
  <div onclick="window.closeProductDetail()" class="absolute inset-0 cursor-pointer"></div>
  <div class="bg-white rounded-2xl p-5 sm:p-6 max-w-lg w-full relative z-10 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <span id="detail-category" class="text-[10px] text-red-600 font-bold tracking-wider uppercase">Kategori</span>
      <button onclick="window.closeProductDetail()" class="text-slate-400 hover:text-slate-900 text-xl cursor-pointer transition-transform hover:scale-110"><i class="ri-close-line"></i></button>
    </div>
    <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
      <div id="detail-slider-container" class="relative w-full sm:w-1/3 bg-slate-50 rounded-xl h-48 sm:h-auto flex items-center justify-center border border-slate-100 shrink-0 overflow-hidden group"></div>
      <div class="w-full sm:w-2/3 space-y-1">
        <p id="detail-brand" class="text-[10px] text-slate-400 font-mono font-bold uppercase tracking-widest">BRAND</p>
        <h3 id="detail-title" class="font-display font-bold text-base sm:text-lg text-slate-900 leading-tight">Nama Produk</h3>
        <p id="detail-price" class="font-display font-black text-red-700 text-sm sm:text-base">Rp 0</p>
        <p id="detail-stock" class="text-[11px] font-bold">Stok: 0</p>
      </div>
    </div>
    <div class="space-y-1">
      <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Deskripsi Produk:</h4>
      <p id="detail-description" class="text-xs text-slate-500 leading-relaxed bg-slate-50/50 p-3 rounded-xl border border-slate-100 whitespace-pre-line"></p>
    </div>
    <div class="space-y-1.5">
      <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Spesifikasi Lengkap:</h4>
      <div id="detail-specs" class="flex flex-wrap gap-1.5"></div>
    </div>
    <div class="pt-3 border-t border-slate-100 flex justify-end">
      <button id="detail-buy-btn" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-semibold transition-all">Masukkan Keranjang</button>
    </div>
  </div>
</div>

<!-- LIGHTBOX GAMBAR -->
<div id="image-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/95 backdrop-blur-sm group">
  <button onclick="window.closeLightbox()" class="absolute top-4 right-4 z-50 text-white hover:text-red-500 text-3xl hover:scale-110 transition-transform cursor-pointer"><i class="ri-close-line"></i></button>
  <div id="lightbox-slider-container" class="w-full h-full"></div>
  <div id="lightbox-nav" class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-between px-2 md:px-6 pointer-events-none hidden z-40">
      <button onclick="window.scrollSlider(event, 'lightbox', -1)" class="pointer-events-auto w-10 h-10 md:w-12 md:h-12 bg-white/10 hover:bg-white/20 text-white rounded-full hidden md:flex items-center justify-center backdrop-blur-md transition-all duration-300 cursor-pointer opacity-0 group-hover:opacity-100"><i class="ri-arrow-left-s-line text-2xl md:text-3xl"></i></button>
      <button onclick="window.scrollSlider(event, 'lightbox', 1)" class="pointer-events-auto w-10 h-10 md:w-12 md:h-12 bg-white/10 hover:bg-white/20 text-white rounded-full hidden md:flex items-center justify-center backdrop-blur-md transition-all duration-300 cursor-pointer opacity-0 group-hover:opacity-100"><i class="ri-arrow-right-s-line text-2xl md:text-3xl"></i></button>
  </div>
  <div id="lightbox-indicator" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-xs font-bold font-mono bg-black/50 px-4 py-1.5 rounded-full tracking-widest hidden z-40"></div>
</div>