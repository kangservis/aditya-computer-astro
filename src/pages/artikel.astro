---
// File: src/pages/artikel.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Artikel Edukasi - Aditya Computer">
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 md:py-8 pb-24 md:pb-8 z-10">
    <section class="space-y-6 md:space-y-8">
      <div class="text-center max-w-xl mx-auto space-y-1">
        <span class="text-red-600 font-semibold text-xs uppercase tracking-widest">
          Artikel Edukasi
        </span>
        <h2 class="font-display font-medium text-xl sm:text-3xl text-slate-900">
          Tips & Info Seputar Komputer
        </h2>
      </div>

      <div
        id="articles-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6"
      >
        <div class="col-span-full py-16 flex flex-col items-center justify-center text-slate-400">
          <i class="ri-loader-4-line animate-spin text-3xl mb-3 text-red-500"></i>
          <p class="text-xs font-semibold tracking-wider uppercase">
            Memuat Artikel...
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- MODAL DETAIL ARTIKEL (Terisolasi hanya di halaman ini) -->
  <div
    id="article-detail-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60"
  >
    <div
      id="close-article-overlay"
      class="absolute inset-0 cursor-pointer"
    ></div>
    <div class="bg-white rounded-2xl p-5 sm:p-6 max-w-3xl w-full relative z-10 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <span
          id="article-detail-date"
          class="text-[10px] text-slate-400 font-mono"
        ></span>
        <button
          id="btn-close-article"
          class="text-slate-400 hover:text-slate-900 text-xl cursor-pointer"
        >
          <i class="ri-close-line"></i>
        </button>
      </div>
      <div class="h-44 sm:h-64 md:h-72 bg-slate-100/60 flex items-center justify-center p-4 rounded-xl overflow-hidden border border-slate-100">
        <img
          id="article-detail-image"
          src=""
          alt="Cover Artikel"
          class="max-h-full max-w-full object-contain"
        />
      </div>
      <div class="space-y-1">
        <h3
          id="article-detail-title"
          class="font-display font-bold text-base sm:text-lg text-slate-900 leading-tight"
        ></h3>
        <p
          id="article-detail-time"
          class="text-[10px] text-slate-400 font-mono flex items-center gap-1"
        ></p>
      </div>
      <div class="h-[1px] bg-slate-100"></div>
      <p
        id="article-detail-content"
        class="text-xs text-slate-600 leading-relaxed whitespace-pre-line"
      ></p>
      <div class="pt-2 flex justify-end">
        <button
          id="btn-close-article-footer"
          class="px-5 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 cursor-pointer"
        >
          Tutup Artikel
        </button>
      </div>
    </div>
  </div>

  <script>
    // @ts-nocheck
    import { getProxyUrl } from "../lib/firebase.js";
    import { loadCollection } from "../lib/data.js";

    let ARTICLES_DATA = [];

    // Dipanggil saat pindah tab (before paint) dan saat halaman dimuat pertama kali
    function mulaiArtikel() {
      const grid = document.getElementById("articles-grid");
      if (!grid || grid.dataset.dimuat) return;
      grid.dataset.dimuat = "1";

      setupArticleModals(); // elemen modal baru tiap kunjungan

      loadCollection("articles", (data) => {
        ARTICLES_DATA = data;
        renderArticles(ARTICLES_DATA);
      }).catch((error) => {
        console.error("Gagal memuat artikel:", error);
        grid.innerHTML =
          '<p class="col-span-full text-center text-red-500 py-10">Gagal memuat artikel.</p>';
      });
    }

    document.addEventListener("astro:after-swap", mulaiArtikel);
    document.addEventListener("astro:page-load", mulaiArtikel);

    function renderArticles(data) {
      const grid = document.getElementById("articles-grid");
      if (!grid) return;
      if (data.length === 0) {
        grid.innerHTML =
          '<p class="col-span-full text-center text-slate-500 py-10">Belum ada artikel edukasi saat ini.</p>';
        return;
      }

      let htmlBuffer = "";
      data.forEach((art) => {
        const proxiedImg = getProxyUrl(art.image);
        htmlBuffer += `
            <div class="bento-card bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-xs flex flex-col justify-between h-full group">
                <div class="h-44 bg-slate-100/60 flex items-center justify-center p-3 border-b border-slate-100">
                    <img src="${proxiedImg}" alt="${art.title}" class="max-h-full max-w-full object-contain" loading="lazy" decoding="async">
                </div>
                <div class="p-4 md:p-5 flex-grow flex flex-col justify-between space-y-3">
                    <div class="space-y-2">
                        <div class="text-[10px] text-slate-400 font-mono flex items-center gap-1.5">
                            <span>${art.date}</span>
                            <span>•</span>
                            <span class="text-red-600 font-semibold">${art.readTime}</span>
                        </div>
                        <h3 class="font-display font-bold text-sm md:text-base text-slate-900 line-clamp-2 group-hover:text-red-600 transition-colors">${art.title}</h3>
                        <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">${art.excerpt}</p>
                    </div>
                    <button data-id="${art.id}" class="btn-read-article w-full mt-2 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 font-bold hover:bg-red-50 hover:text-red-600 hover:border-red-100 transition-colors cursor-pointer">Baca Selengkapnya</button>
                </div>
            </div>`;
      });
      grid.innerHTML = htmlBuffer;

      // Binding tombol baca ke fungsi modal
      document.querySelectorAll(".btn-read-article").forEach((btn) => {
        btn.addEventListener("click", (e) =>
          openArticleDetail(e.target.dataset.id),
        );
      });
    }

    function openArticleDetail(artId) {
      const art = ARTICLES_DATA.find((a) => a.id === artId);
      if (!art) return;

      document.getElementById("article-detail-date").innerText = art.date;
      document.getElementById("article-detail-image").src = getProxyUrl(
        art.image,
      );
      document.getElementById("article-detail-title").innerText = art.title;
      document.getElementById("article-detail-time").innerHTML =
        `<i class="ri-time-line"></i> ${art.readTime}`;
      document.getElementById("article-detail-content").innerText = art.content;

      document
        .getElementById("article-detail-modal")
        .classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeArticleDetail() {
      document.getElementById("article-detail-modal").classList.add("hidden");
      document.body.style.overflow = "";
    }

    function setupArticleModals() {
      document
        .getElementById("close-article-overlay")
        ?.addEventListener("click", closeArticleDetail);
      document
        .getElementById("btn-close-article")
        ?.addEventListener("click", closeArticleDetail);
      document
        .getElementById("btn-close-article-footer")
        ?.addEventListener("click", closeArticleDetail);
    }
  </script>
</Layout>
